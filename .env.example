# Copy to .env.local for local development:
#   cp .env.example .env.local
#
# Then fill in real values. Never commit .env.local.

# --- Required for contact form storage (server-only) ---
# Supabase → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
# Use the service_role secret key, NOT the anon/public key.
# Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Optional: email notification after a row is stored ---
RESEND_API_KEY=re_xxxxxxxx
CONTACT_TO_EMAIL=contact@kordran.com
CONTACT_FROM_EMAIL="Kordran Website <noreply@yourdomain.com>"

# --- Optional: analytics / Search Console ---
NEXT_PUBLIC_GA_ID=G-XXXXXXXX
GOOGLE_SITE_VERIFICATION=xxxxxxxx
