# Copy to .env.local for local development:
#   cp .env.example .env.local
#
# Then fill in real values. Never commit .env.local.

# The homepage is always indexable. Set this to "true" to open notes,
# llms.txt, the feed, and the rest of the site to crawlers.
# Rebuild after changing this.
INDEXING_ENABLED=false

# IndexNow key. When set, the build writes public/<key>.txt.
# INDEXNOW_KEY=
