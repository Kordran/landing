# Copy to .env.local for local development:
#   cp .env.example .env.local
#
# Then fill in real values. Never commit .env.local.

# Homepage is always indexable. Set to "false" to noindex everything else.
# This must be available when Next builds, not only at runtime.
# Rebuild after changing this.
INDEXING_ENABLED=true

# IndexNow key. When set, the build writes public/<key>.txt.
# INDEXNOW_KEY=
